---
import { getDict } from "../i18n";
import Kallpa from "./Kallpa.astro";
const t = getDict(Astro.currentLocale);
const a = t.activities;
---
<section class="sec acts" id="act">
  <div class="mw">
    <div class="act-top rv">
      <div>
        <p class="stag">{a.tag}</p>
        <h2 class="sh">{a.title}</h2>
      </div>
      <p class="act-sub">{a.sub}</p>
    </div>

    <div class="act-grid rv">
      <div class="ac ind">
        <div class="ac-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#71469C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="13" cy="4" r="2"/><path d="M13 6v5l4 2M13 11l-4 1-2 4M9 12l1 4-2 4M17 13l2-1"/></svg></div>
        <p class="ac-lbl">{a.indoor.label}</p>
        <h3 class="ac-h">{a.indoor.title}</h3>
        <ul>{a.indoor.items.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="ac out">
        <div class="ac-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#59AC00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18L14 6l-3 5-2-2-6 11z"/><path d="M11 11l3-5"/></svg></div>
        <p class="ac-lbl">{a.outdoor.label}</p>
        <h3 class="ac-h">{a.outdoor.title}</h3>
        <ul>{a.outdoor.items.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="ac ext">
        <div class="ac-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#034096" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.6 6.3 6.8.5-5.2 4.4 1.6 6.6L12 16.7 6.2 20.3l1.6-6.6L2.6 8.8l6.8-.5z"/></svg></div>
        <p class="ac-lbl">{a.extra.label}</p>
        <h3 class="ac-h">{a.extra.title}</h3>
        <ul>{a.extra.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>

    <Kallpa />
  </div>
</section>

<style>
  .acts { background: #FDFAF5; }
  .act-top { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 36px; }
  .act-sub { font-size: 14px; color: var(--muted); max-width: 240px; line-height: 1.6; }
  .act-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .ac { padding: clamp(20px, 3vw, 30px); transition: transform .3s, box-shadow .3s; }
  .ac:hover { transform: translateY(-4px); box-shadow: 0 10px 28px rgba(0, 0, 0, .07); }
  .ac.ind { background: #EDE0F5; }
  .ac.out { background: var(--Gl); }
  .ac.ext { background: var(--Bl); }
  .ac-icon { width: 44px; height: 44px; margin-bottom: 14px; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
  .ac.ind .ac-icon { background: rgba(113, 70, 156, .12); }
  .ac.out .ac-icon { background: rgba(89, 172, 0, .12); }
  .ac.ext .ac-icon { background: rgba(3, 64, 150, .12); }
  .ac-icon svg { width: 24px; height: 24px; }
  .ac-lbl { font-family: var(--f-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 6px; }
  .ac.ind .ac-lbl { color: var(--V); }
  .ac.out .ac-lbl { color: var(--Gdk); }
  .ac.ext .ac-lbl { color: var(--B); }
  .ac-h { font-family: var(--f-display); font-size: clamp(20px, 2.5vw, 26px); color: var(--ink); margin-bottom: 12px; }
  .ac ul { list-style: none; }
  .ac li { font-size: 13px; color: var(--muted); padding: 5px 0 5px 16px; position: relative; border-bottom: 1px solid rgba(0, 0, 0, .06); }
  .ac li:last-child { border-bottom: none; }
  .ac li::before { content: "→"; position: absolute; left: 0; font-size: 11px; opacity: .35; }

  @media (max-width: 900px) { .act-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .act-grid { grid-template-columns: 1fr; } }
</style>
