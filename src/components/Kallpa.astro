---
import { Image } from "astro:assets";
import { getDict } from "../i18n";
import kallpa from "../assets/foto-kallpa.jpeg";
const t = getDict(Astro.currentLocale);
const k = t.kallpa;
---
<div class="kallpa rv">
  <figure class="kallpa-img">
    <Image src={kallpa} alt={k.imgAlt} widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" loading="lazy" />
  </figure>
  <div>
    <p class="k-tag">{k.tag}</p>
    <h3 class="k-h">{k.title}</h3>
    <span class="k-badge">{k.badge}</span>
    <p class="k-p">{k.text}</p>
  </div>
</div>

<style>
  .kallpa {
    margin-top: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 40px); align-items: center;
    background: var(--Ll); border: 2px solid var(--L); padding: clamp(24px, 4vw, 40px);
  }
  .kallpa-img { aspect-ratio: 4 / 3; overflow: hidden; border: 2px solid var(--L); }
  .kallpa-img img { width: 100%; height: 100%; object-fit: cover; }
  .k-tag { font-family: var(--f-mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--Ld); margin-bottom: 7px; }
  .k-h { font-family: var(--f-display); font-size: clamp(28px, 4vw, 50px); color: var(--Ld); margin-bottom: 10px; }
  .k-badge { display: inline-block; background: var(--Ld); color: #fff; font-family: var(--f-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; padding: 5px 12px; margin-bottom: 12px; }
  .k-p { font-size: 14px; color: #3A2050; line-height: 1.7; }
  @media (max-width: 768px) { .kallpa { grid-template-columns: 1fr; } }
</style>
