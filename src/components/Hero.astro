---
import { getDict, SITE } from "../i18n";
import Icon from "./Icon.astro";
const t = getDict(Astro.currentLocale);
---
<section class="hero" id="inici">
  <div class="hero-9a" aria-hidden="true">9A</div>
  <div class="hero-in mw">
    <p class="hero-pill">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.4 7.4H22l-6 4.5 2.3 7.1L12 16.5 5.7 21l2.3-7.1-6-4.5h7.6z"/></svg>
      {t.hero.pill}
    </p>
    <h1 class="hero-h1">
      {t.hero.h1a}<br /><span class="acc">{t.hero.h1b}</span><br /><span class="gr">{t.hero.h1c}</span>
    </h1>
    <p class="hero-p">{t.hero.text}</p>
    <div class="hero-btns">
      <a href={`https://wa.me/${SITE.whatsapp}?text=Hola!`} target="_blank" rel="noopener" class="btn-wa">
        <Icon name="whatsapp" />{t.hero.waBtn}
      </a>
      <a href="#act" class="btn-o">{t.hero.actBtn}</a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="stn">10</div>
        <div class="stl">{t.hero.stat1Label}</div>
      </div>
      <div>
        <div class="stn">Indoor &amp; Outdoor</div>
        <div class="stl">{t.hero.stat2Label}</div>
      </div>
      <div>
        <div class="stn">{t.hero.stat3}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end;
    padding: clamp(96px, 14vh, 140px) clamp(18px, 4vw, 40px) clamp(32px, 5vh, 56px);
    border-bottom: 2px solid var(--ink); position: relative; overflow: hidden;
  }
  .hero-9a {
    position: absolute; right: -12px; top: -24px;
    font-family: var(--f-display); font-size: clamp(180px, 28vw, 380px); line-height: 1; letter-spacing: -8px;
    color: var(--G); opacity: .1; pointer-events: none; user-select: none;
  }
  .hero-in { position: relative; z-index: 1; }
  .hero-pill {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--f-mono); font-size: clamp(9px, 1.4vw, 11px); letter-spacing: .14em; text-transform: uppercase;
    color: var(--G); background: var(--Gl); padding: 7px 14px; margin-bottom: 18px;
  }
  .hero-pill svg { flex-shrink: 0; }
  .hero-h1 { font-family: var(--f-display); font-size: clamp(46px, 9vw, 108px); line-height: .91; margin-bottom: 18px; color: var(--ink); }
  .acc { display: inline-block; background: var(--V); color: var(--cream); padding: 0 .18em; margin: .04em 0; }
  .gr { color: var(--G); }
  .hero-p { font-size: clamp(14px, 1.8vw, 18px); color: var(--muted); max-width: min(580px, 88vw); line-height: 1.65; margin-bottom: 28px; }
  .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 36px; }
  .btn-o {
    display: inline-flex; align-items: center; background: transparent; color: var(--ink);
    font-family: var(--f-mono); font-size: 11px; letter-spacing: .09em; text-transform: uppercase;
    padding: 13px clamp(14px, 2vw, 24px); border: 2px solid var(--ink); transition: all .2s;
  }
  .btn-o:hover { background: var(--ink); color: var(--cream); }
  .hero-stats { display: flex; gap: clamp(20px, 4vw, 48px); flex-wrap: wrap; border-top: 1px solid var(--border); padding-top: 22px; }
  .stn { font-family: var(--f-display); font-size: clamp(22px, 3.5vw, 40px); color: var(--B); }
  .stl { font-family: var(--f-mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-top: 2px; }
</style>
