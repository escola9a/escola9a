---
import { getDict, SITE } from "../i18n";
import Icon from "./Icon.astro";
const t = getDict(Astro.currentLocale);
const b = t.booking;
const waUrl = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(b.waText)}`;
---
<section class="sec reserva on-dark" id="res">
  <div class="mw">
    <div class="rv">
      <p class="stag">{b.tag}</p>
      <h2 class="sh">{b.title}</h2>
    </div>
    <div class="res-g">
      <div class="res-txt rv">
        <p>{b.text}</p>
        <a href={waUrl} target="_blank" rel="noopener" class="btn-wa wa-btn">
          <Icon name="whatsapp" />{b.waBtn}
        </a>
        <div class="wa-note">
          <span class="wa-dot" aria-hidden="true"></span>
          <span>{b.note}</span>
        </div>
      </div>
      <div class="res-steps-box rv">
        <h3 class="res-steps-h">{b.stepsTitle}</h3>
        <ol class="res-steps">
          {b.steps.map((s, i) => (
            <li class="res-step"><span class="res-n" aria-hidden="true">{i + 1}</span><span class="res-txt-s">{s}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .reserva { background: var(--ink); }
  .res-g { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); margin-top: 40px; align-items: center; }
  .res-txt p { font-size: 15px; color: var(--on-dark); line-height: 1.75; margin-bottom: 24px; }
  .wa-btn { gap: 10px; padding: 14px 26px; }
  .wa-note { display: flex; align-items: center; gap: 8px; margin-top: 16px; }
  .wa-dot { width: 7px; height: 7px; background: var(--G); border-radius: 50%; flex-shrink: 0; }
  .wa-note span:last-child { font-family: var(--f-mono); font-size: 12px; color: var(--on-dark); }
  .res-steps-box { background: rgba(245, 240, 232, .05); border: 1px solid rgba(245, 240, 232, .12); padding: clamp(22px, 3vw, 34px); }
  .res-steps-h { font-family: var(--f-display); font-size: 26px; color: var(--cream); margin-bottom: 16px; }
  .res-steps { list-style: none; }
  .res-step { display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid rgba(245, 240, 232, .08); align-items: flex-start; }
  .res-step:last-child { border-bottom: none; }
  .res-n { font-family: var(--f-display); font-size: 28px; color: var(--Vdk); line-height: 1; flex-shrink: 0; min-width: 24px; }
  .res-txt-s { font-size: 14px; color: var(--on-dark); line-height: 1.6; padding-top: 4px; }
  @media (max-width: 768px) { .res-g { grid-template-columns: 1fr; } }
</style>
